#!/usr/bin/env bash
# Manage the Thoric installation inside the WSL distribution.
set -euo pipefail
INSTALL=/opt/thoric
# The manager the package installs, and where its releases are listed.
MANAGER_REPOSITORY=ghcr.io/co3moz/thoric
RELEASES=https://api.github.com/repos/co3moz/thoric/releases/latest
# The installation files every manager image bundles under /app/install. The package and each update
# record their checksums in .shipped.sha256, which tells an update whether a file was edited by hand.
INSTALL_FILES=(compose.yml deploy/Caddyfile .env.example)
# Every manager image bundles this command as well, and an update installs it from a newer release; see
# update_cli. The package build and that update fill in the release the command came with, and
# NEEDS_PACKAGE is the lowest package level it works on. An older command reads both lines from a newer
# one before it installs it, so they keep this form.
CLI=/usr/local/bin/thoric
CLI_VERSION=
# shellcheck disable=SC2034 # read from this file by the command an update replaces
NEEDS_PACKAGE=1
# The package records the level of its own files here, such as the firewall watcher and its unit. A
# package without the file is level 1. The file also marks the distribution as Thoric's package,
# whose system an update keeps current: see update_system.
PACKAGE_LEVEL=/usr/lib/wsl/package-level
# The package's own files outside the installation folder, which every manager image bundles under
# /app/install/system at the same paths and an update installs from the release of this command,
# raising the package level to SYSTEM_LEVEL. SYSTEM_RECORD holds the checksum each had when the
# package or an update installed it, which tells an update a file edited by hand from one it may
# replace; SYSTEM_ROOT is the root they are under, / in the distribution.
SYSTEM_FILES=(/etc/apt/preferences.d/thoric-docker.pref /etc/docker/daemon.json /etc/systemd/system/thoric-firewall.service /usr/lib/wsl/firewall-watch.sh /usr/lib/wsl/keepalive.sh /usr/share/bash-completion/completions/thoric)
SYSTEM_RECORD=/usr/lib/wsl/system.sha256
SYSTEM_ROOT=
SYSTEM_LEVEL=2
# The versions of those files the packages before the record shipped, 0.8.0 to 0.9.3, so an update
# tells them from files edited by hand there too.
SHIPPED_BEFORE_RECORD=(
    "5fdaaad4da5553df7a81ad9d7972703e2baae2ccc0e62d1be525a167100d613b /etc/docker/daemon.json"
    "419d1253ce23c2911cc05303b1b6cf657b16a57dc5543617ccb6c716bd36ce4a /etc/docker/daemon.json"
    "db5324e1cafbd7d735e1ab9fe7e9607441385a3a1b1a5559294e7bc27b1fc664 /etc/systemd/system/thoric-firewall.service"
    "4279f9bc73e05585d84368c80926960ae49d504dbe6f3a85d472a9d8d9cd2eb1 /usr/lib/wsl/firewall-watch.sh"
    "296812c144988e34ce4200e893ae2771e9a3547380bc75eb5ca641197ca6cfa8 /usr/lib/wsl/keepalive.sh"
    "32a0b0f5e4c5eaf41e8e771aa6669baed0e23b184906f4300655deab10ec0366 /usr/share/bash-completion/completions/thoric"
)
# Docker's socket, which compose.yml mounts into the manager. A container keeps the socket it was
# created with, so the manager is created again when an update makes the socket again, as Docker's
# package scripts do where nothing keeps them from restarting services (see update_system).
DOCKER_SOCKET=/var/run/docker.sock
# The units that run an update or a settings change the dashboard asks for. Every manager image
# bundles them under /app/install/systemd, and the package installs them as well; see update_units.
UNIT_DIR=/etc/systemd/system
UPDATE_UNITS=(thoric-update.path thoric-update.service)
SETTINGS_UNITS=(thoric-settings.path thoric-settings.service)
# The settings the dashboard's Settings page may change, through apply-settings: EDITABLE in
# core/manager/src/config.rs, and the tests hold the two lists together. The rest of .env, such as
# the password, the agent token and the published port, changes only with 'thoric settings'.
DASHBOARD_SETTINGS=(SECURE_COOKIE ALLOWED_HOSTS DESKTOP_IMAGE DESKTOP_USER_NAMESPACES DESKTOP_PIDS_LIMIT DESKTOP_ADDRESS_POOL WSL_GPU NVIDIA_COMPUTE GPU_ADAPTER AUDIO_ENABLED MICROPHONE_ENABLED INTERNET_ENABLED SUDO_ENABLED GAMEPAD_ENABLED VPN_ENABLED GPU_DEFAULT INTERNET_DEFAULT SUDO_DEFAULT AUDIO_DEFAULT MICROPHONE_DEFAULT GAMEPAD_DEFAULT VPN_DEFAULT IDLE_STOP_DEFAULT UPLOAD_MAX_MB IMAGE_ARCHIVE_MAX_MB TEMPLATES_URL VOLUME_FILTER PROXY_URL PROXY_USERNAME PROXY_BYPASS UPDATE_CHECK NOTIFY_URL NOTIFY_EVENTS DASHBOARD_URL)
# Those of them that are secrets, EDITABLE_SECRETS in core/manager/src/config.rs: apply-settings
# writes their values into .env alone, never into its output, which is the dashboard job's log.
DASHBOARD_SECRETS=(NOTIFY_URL)
# How long apply-settings waits for the manager to answer with the new settings, and an update for
# the new manager, which may first move its database to a new layout, in seconds.
SETTINGS_WAIT=90
UPDATE_WAIT=180

# Tab completion offers the first word of each indented line, so every command is listed here.
usage() {
    cat <<'EOF'
Usage: thoric <command>

  start     Start Docker if needed, download the manager if missing and start it
  stop      Stop the manager (desktop containers stop with the distribution)
  restart   Recreate the manager with the current settings
  status    Show the manager state and the dashboard address
  logs      Show the manager's recent log output
  update    Move the manager, its compose.yml and this command to the newest release, bring the distribution's packages and system files up to date, recreate the manager (or go back when it does not answer), then pull downloaded desktop images
  system    Bring the distribution's packages, Docker Engine and the NVIDIA toolkit among them, and its system files up to date without moving the manager
  doctor    Check Docker, its firewall, memory, disk, GPU access, settings and whether Docker reaches the registry
  open      Open the dashboard in the Windows browser
  mcp       Show the agent (MCP) endpoint, its token and client configuration
  settings  Edit /opt/thoric/.env, then run 'thoric restart'
  apply-settings <request>  Apply a settings change from the dashboard; thoric-settings.service runs it as root
EOF
}
compose() {
    (cd "$INSTALL" && docker compose "$@")
}
require_settings() {
    if [[ ! -f $INSTALL/.env ]]; then
        echo "Settings are missing. Open a new Thoric terminal to run the first-start setup." >&2
        exit 1
    fi
}
ensure_docker() {
    if ! systemctl is-active --quiet docker; then
        sudo systemctl start docker
    fi
    if docker_ready; then return 0; fi
    echo "Docker did not become ready. Run 'thoric doctor'." >&2
    exit 1
}
# Whether Docker answers within 30 seconds.
docker_ready() {
    local _
    for _ in $(seq 1 30); do
        if docker info >/dev/null 2>&1; then return 0; fi
        sleep 1
    done
    return 1
}
# The port the dashboard answers on is a setting, so the command follows .env, not the shell.
port() {
    local value=
    if [[ -f $INSTALL/.env ]]; then value=$(setting PORT); fi
    echo "${value:-8080}"
}
address() {
    echo "http://localhost:$(port)"
}
# Who reaches the dashboard follows the address Compose publishes the port on, 127.0.0.1 unless set.
access() {
    local bind=
    if [[ -f $INSTALL/.env ]]; then bind=$(setting BIND_ADDRESS); fi
    bind=${bind:-127.0.0.1}
    if [[ $bind == 127.* || $bind == localhost ]]; then
        echo "this computer only ($bind:$(port))"
    else
        echo "other devices too ($bind:$(port))"
    fi
}
# One setting from .env, without the quotes the first start puts around some values.
setting() {
    local value
    value=$(sed -n "s/^$1=//p" "$INSTALL/.env" | tail -n1)
    if [[ $value =~ ^\'(.*)\'$ || $value =~ ^\"(.*)\"$ ]]; then value=${BASH_REMATCH[1]}; fi
    printf '%s\n' "$value"
}
# .env belongs to root, so it changes through sudo; sed keeps its owner and mode. The values set
# here are image references, which hold no character that sed or the shell treats specially.
set_setting() {
    if grep -q "^$1=" "$INSTALL/.env"; then
        sudo sed -i "s|^$1=.*|$1=$2|" "$INSTALL/.env"
    else
        printf '%s=%s\n' "$1" "$2" | sudo tee -a "$INSTALL/.env" >/dev/null
    fi
}
# Settings a release renamed, as OLD=NEW. The manager reads an old name while the new one is
# missing and says to rename it; an update renames it in .env, or drops it when the new name is
# there already, since that one applies.
RENAMED_SETTINGS=(MCP_ENABLED=ROOT_MCP_ENABLED)
rename_settings() {
    local pair old new
    for pair in "${RENAMED_SETTINGS[@]}"; do
        old=${pair%%=*} new=${pair#*=}
        if ! grep -q "^$old=" "$INSTALL/.env"; then
            continue
        fi
        if grep -q "^$new=" "$INSTALL/.env"; then
            sudo sed -i "/^$old=/d" "$INSTALL/.env"
            echo "Removed $old from .env; $new applies."
        else
            sudo sed -i "s/^$old=/$new=/" "$INSTALL/.env"
            echo "Renamed $old to $new in .env."
        fi
    done
}
# Prints the version of the newest published release, without the v of its tag.
newest_release() {
    local version
    version=$(curl -fsS --max-time 20 "$RELEASES" | grep -o '"tag_name": *"v[^"]*"' | head -n1 |
        sed 's/.*"v\([^"]*\)"$/\1/') || true
    if ! [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "Could not find the newest release at $RELEASES; nothing was updated." >&2
        return 1
    fi
    echo "$version"
}
# Desktop profiles download on first use, so refresh only the ones this host already has. A published
# manager, labelled with its version or, for an edge build, sha-<commit>, downloads the desktop images
# published with it and tags them as the catalog reference; a manager built from the source downloads
# the reference itself. This does the same.
update_profiles() {
    local catalog release ref refs source source_was_here replaced
    if ! catalog=$(compose exec -T manager cat /app/desktop/profiles.json) ||
        ! release=$(docker inspect --format '{{index .Config.Labels "thoric.release"}}' "$(compose ps -q manager)"); then
        echo "Could not read the profile catalog from the manager; desktop images were not updated." >&2
        return 1
    fi
    mapfile -t refs < <(sed -n 's/.*"reference": *"\([^"]*\)".*/\1/p' <<<"$catalog")
    for ref in "${refs[@]}"; do
        if ! replaced=$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null); then
            continue
        fi
        if [[ $release =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; then
            source=${ref%:*}:$release
            # As in the manager, a release tag that was here before stays.
            source_was_here=""
            if docker image inspect "$source" >/dev/null 2>&1; then source_was_here=yes; fi
            docker pull "$source"
            docker tag "$source" "$ref"
            if [[ -z $source_was_here ]]; then docker image rm "$source" >/dev/null || true; fi
        else
            docker pull "$ref"
        fi
        remove_replaced "$ref" "$replaced"
    done
}
# Prints free when no record in the manager's database keeps the image its argument names: a
# container record that starts from it, which a reset creates from it again, or a saved image's
# record that names it. It fails when a record does not read, since that one may. The manager
# applies the same rules (core/manager/src/image_removal.rs), and its tests hold the names read here
# to its records.
IMAGE_RECORDS='
import json, os, sqlite3, sys
path = os.path.join(os.environ.get("DATA_DIR", "data"), "state.sqlite")
database = sqlite3.connect("file:" + path + "?mode=ro", uri=True)
for kind, field in (("environment", "source_image_id"), ("image", "image_id")):
    for (data,) in database.execute("SELECT data FROM records WHERE kind = ?", (kind,)):
        if json.loads(data)[field] == sys.argv[1]:
            sys.exit("needed")
print("free")
'
# The image a catalog reference named before the update moved it, which Docker otherwise keeps
# without a name, 1 to 2 GB for each release. It goes only when nothing needs it: no other tag,
# such as a release tag that was here before, no record of the manager and no container, which
# Docker checks itself, since nothing is forced.
remove_replaced() {
    local ref=$1 replaced=$2 short=${2#sha256:} tags needed
    short=${short:0:12}
    if [[ $(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null) == "$replaced" ]] ||
        ! tags=$(docker image inspect --format '{{len .RepoTags}}' "$replaced" 2>/dev/null); then
        return 0
    fi
    if [[ $tags != 0 ]]; then
        echo "The image $ref named before, $short, stays, since another tag names it."
        return 0
    fi
    needed=$(compose exec -T manager python3 -c "$IMAGE_RECORDS" "$replaced" 2>/dev/null) || needed=""
    if [[ $needed != free ]]; then
        echo "The image $ref named before, $short, stays, since a container or a saved image was made from it."
    elif docker image rm "$replaced" >/dev/null 2>&1; then
        echo "Removed the image $ref named before, $short."
    else
        echo "The image $ref named before, $short, stays, since a container or an image built on it uses it."
    fi
}
checksum() {
    sha256sum <"$1" | cut -c1-64
}
# Installation files belong to root, so they change through sudo: written beside the old file and
# renamed over it, so a failed write leaves the old one whole and a running command keeps reading the
# file it started from. A file keeps its owner, and its mode unless a third argument names one.
put_file() {
    local target=$1 owner=(-m "${3:-0644}")
    if [[ -e $target ]]; then
        owner=(-m "${3:-$(stat -c %a "$target")}" -o "$(stat -c %u "$target")" -g "$(stat -c %g "$target")")
    fi
    sudo install -D "${owner[@]}" "$2" "$target.new"
    sudo mv -f "$target.new" "$target"
}
# The command comes only from releases, like the package's own, and never from a MANAGER_IMAGE chosen
# by hand. That manager already runs with the Docker socket, but as a container the next change of
# MANAGER_IMAGE replaces, while a command it installed would stay and keep running with sudo. A release
# replaces the command when it is newer than this one, never older, and only when this package has the
# level of files the new command needs. The new command then runs the whole update again, so the rest
# of it follows the new release's rules. Each replacement records a newer release, which the new
# command finds equal to its own, so the update ends.
update_cli() {
    local image=$1 release=${1#"$MANAGER_REPOSITORY":} new=$tmp/thoric needs level
    if [[ $release == "$image" || ! $release =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "MANAGER_IMAGE is not a release, so the thoric command stays as it is."
        return 0
    fi
    if [[ $CLI_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ &&
        $(printf '%s\n' "$release" "$CLI_VERSION" | sort -V | tail -n1) == "$CLI_VERSION" ]]; then
        return 0
    fi
    if ! docker run --rm --network none --entrypoint cat "$image" /app/install/thoric >"$new" 2>/dev/null ||
        [[ ! -s $new ]]; then
        echo "$image has no thoric command; this one stays as it is." >&2
        return 0
    fi
    needs=$(sed -n 's/^NEEDS_PACKAGE=\([0-9][0-9]*\)$/\1/p' "$new" | head -n1)
    sed -i "s|^CLI_VERSION=.*|CLI_VERSION=$release|" "$new"
    if [[ -z $needs ]] || ! grep -qFx "CLI_VERSION=$release" "$new" || ! bash -n "$new" 2>/dev/null; then
        echo "The thoric command in $image is incomplete; this one stays as it is." >&2
        return 0
    fi
    level=$(cat "$PACKAGE_LEVEL" 2>/dev/null || true)
    if ! [[ $level =~ ^[0-9]+$ ]]; then level=1; fi
    if ((10#$needs > 10#$level)); then
        echo "The thoric command of $release needs a newer WSL package (level $needs, this one has $level), so this one stays as it is."
        return 0
    fi
    put_file "$CLI" "$new" 0755
    echo "The thoric command moves from ${CLI_VERSION:-an earlier version} to $release; the update continues with it."
    # exec skips the EXIT trap.
    rm -rf "$tmp"
    exec "$CLI" update
}
# Settings added in a release reach the manager only through the environment list in its compose.yml,
# so an update brings the installation files of the manager it runs. A file still as it was installed
# is replaced. One edited by hand stays when the release brings the same file again; otherwise it is
# saved as <file>.bak first. .env holds the settings and is never one of them.
update_install_files() {
    local image=$1 file new current shipped
    for file in "${INSTALL_FILES[@]}"; do
        mkdir -p "$tmp/$(dirname "$file")"
        if ! docker run --rm --network none --entrypoint cat "$image" "/app/install/$file" >"$tmp/$file" ||
            [[ ! -s $tmp/$file ]]; then
            echo "$image has no /app/install/$file; the installation files stay as they are." >&2
            return 0
        fi
    done
    # Like the package, the example names the manager this installation runs.
    sed -i "s|^MANAGER_IMAGE=.*|MANAGER_IMAGE=$image|" "$tmp/.env.example"
    (cd "$tmp" && sha256sum "${INSTALL_FILES[@]}") >"$tmp/.shipped.sha256"
    for file in "${INSTALL_FILES[@]}"; do
        new=$(checksum "$tmp/$file")
        current=""
        if [[ -e $INSTALL/$file ]]; then current=$(checksum "$INSTALL/$file"); fi
        shipped=$(awk -v file="$file" '$2 == file { print $1 }' "$INSTALL/.shipped.sha256" 2>/dev/null || true)
        if [[ $current == "$new" ]]; then
            continue
        elif [[ -n $current && $current != "$shipped" ]]; then
            if [[ $new == "$shipped" ]]; then continue; fi
            sudo cp -p "$INSTALL/$file" "$INSTALL/$file.bak"
            echo "$file had changes of your own; they are saved in $INSTALL/$file.bak. Carry over what you still need."
        fi
        put_file "$INSTALL/$file" "$tmp/$file"
        echo "Updated $file."
    done
    put_file "$INSTALL/.shipped.sha256" "$tmp/.shipped.sha256"
}
# What an update changes before the new manager answers: .env, with the pin and renamed settings,
# and the installation files. keep_previous copies them into $tmp/previous, with owner and mode,
# and notes the ones that were missing; take_back puts them back.
UPDATED_FILES=(.env "${INSTALL_FILES[@]}" .shipped.sha256)
keep_previous() {
    local file
    previous=$tmp/previous
    mkdir -p "$previous"
    for file in "${UPDATED_FILES[@]}"; do
        if [[ -e $INSTALL/$file ]]; then
            mkdir -p "$previous/$(dirname "$file")"
            sudo cp -p "$INSTALL/$file" "$previous/$file"
        else
            echo "$file" >>"$previous/.missing"
        fi
    done
}
# The EXIT trap of an update from keep_previous on: until the new manager answers, which clears
# $previous, any end of the update puts the files back and recreates the manager they name, so
# .env never stays on a manager that does not start. The command and the units an update brought
# stay, since they work with earlier managers as well.
finish_update() {
    local status=$? file
    if [[ -n $previous ]]; then
        status=1
        echo "Taking the update back: $INSTALL/.env and the installation files are put back as they were."
        for file in "${UPDATED_FILES[@]}"; do
            if [[ -e $previous/$file ]]; then
                put_file "$INSTALL/$file" "$previous/$file" || echo "Could not put back $INSTALL/$file." >&2
            elif grep -qxF "$file" "$previous/.missing" 2>/dev/null; then
                sudo rm -f "$INSTALL/$file"
            fi
        done
        echo "Recreating the previous manager."
        if compose up -d && manager_answers "$UPDATE_WAIT"; then
            echo "The previous manager answers again."
        else
            echo "The previous manager does not answer either. Run 'thoric logs' and 'thoric doctor'."
        fi
    fi
    rm -rf "$tmp"
    exit "$status"
}
# The dashboard asks for an update or a settings change by leaving a request in $INSTALL/update,
# which the manager sees at /update. thoric-update.path notices an update and
# thoric-update.service runs this command's update as root; thoric-settings.path and
# thoric-settings.service do the same for apply-settings. Like the command, the units come only
# from releases, since they run as root and would stay after a MANAGER_IMAGE chosen by hand is gone.
# An update brings them to an installation whose package came before them, and enables them only
# then or when a release changes them, so a path unit turned off by hand stays off. The manager
# offers the update once the folder holds 'watched', and settings changes once it holds
# 'settings-watched'.
update_units() {
    local image=$1 release=${1#"$MANAGER_REPOSITORY":}
    if [[ $release == "$image" || ! $release =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        return 0
    fi
    install_units "$image" watched "updates" "The dashboard can update this installation from now on." \
        "${UPDATE_UNITS[@]}"
    install_units "$image" settings-watched "settings changes" "The dashboard can change settings from now on." \
        "${SETTINGS_UNITS[@]}"
}
# One path unit and the service it starts, from the release image, and the file in the folder that
# tells the manager they are there.
install_units() {
    local image=$1 marker=$2 what=$3 done=$4 unit changed=""
    shift 4
    for unit in "$@"; do
        if ! docker run --rm --network none --entrypoint cat "$image" "/app/install/systemd/$unit" >"$tmp/$unit" 2>/dev/null ||
            [[ ! -s $tmp/$unit ]]; then
            echo "$image has no $unit, so $what from the dashboard stay as they are."
            return 0
        fi
    done
    for unit in "$@"; do
        if ! cmp -s "$tmp/$unit" "$UNIT_DIR/$unit"; then
            put_file "$UNIT_DIR/$unit" "$tmp/$unit" 0644
            changed=yes
        fi
    done
    if [[ -n $changed ]]; then
        sudo systemctl daemon-reload
        sudo systemctl enable --now "$1"
        sudo install -d -m 0755 "$INSTALL/update"
        sudo touch "$INSTALL/update/$marker"
        echo "$done"
    fi
}
# The distribution is Thoric's package, so an update keeps its system current: the package's own
# files as the release of this command has them, and the distribution's packages, Docker Engine and
# the NVIDIA Container Toolkit among them, which nothing else updates, since the image has no
# unattended upgrades. Neither fails the update: what could not be done is said, and the next update,
# or 'thoric system', tries again. The image's /usr/sbin/policy-rc.d keeps package scripts from
# restarting services, so containerd and Docker are restarted here when their packages change, and
# Docker when its daemon.json does, unless something restarted it already; Docker runs with
# live-restore, so containers keep running. Needs $tmp.
update_system() {
    local image=$1 pid restart=()
    pid=$(docker_pid)
    system_changed=()
    upgraded=()
    update_system_files "$image"
    upgrade_packages
    if listed containerd.io "${upgraded[@]}"; then restart+=(containerd); fi
    if ((${#restart[@]})) || listed docker-ce "${upgraded[@]}" || listed /etc/docker/daemon.json "${system_changed[@]}"; then
        restart+=(docker)
    fi
    if ((${#restart[@]})) && [[ $(docker_pid) == "$pid" ]]; then
        echo "Restarting ${restart[*]} to run the new versions and configuration; containers keep running."
        sudo systemctl restart "${restart[@]}"
    fi
    if listed /etc/docker/daemon.json "${system_changed[@]}" && ! docker_ready &&
        [[ -e $tmp/system-previous/etc/docker/daemon.json ]]; then
        echo "Docker does not start with the new daemon.json, so the previous one is back." >&2
        put_file "$SYSTEM_ROOT/etc/docker/daemon.json" "$tmp/system-previous/etc/docker/daemon.json"
        sudo systemctl restart docker
    fi
    ensure_docker
}
docker_pid() {
    systemctl show --property MainPID --value docker 2>/dev/null || true
}
# Docker's socket as a file, which changes when Docker Engine makes it again, as Docker's package
# scripts do where they may restart services.
socket_id() {
    stat -c %i "$DOCKER_SOCKET" 2>/dev/null || true
}
# Whether the first argument is one of the others.
listed() {
    local item needle=$1
    shift
    for item; do
        if [[ $item == "$needle" ]]; then return 0; fi
    done
    return 1
}
# The checksum a system file had when the package or an update installed it, given the one it has
# now, or nothing when that is unknown.
shipped_system() {
    local path=$1 current=$2 line
    if [[ -f $SYSTEM_RECORD ]]; then
        awk -v path="$path" '$2 == path { print $1 }' "$SYSTEM_RECORD"
        return 0
    fi
    for line in "${SHIPPED_BEFORE_RECORD[@]}"; do
        if [[ -n $current && $line == "$current $path" ]]; then
            echo "$current"
            return 0
        fi
    done
}
# The package's own files as the release of this command has them, from its manager image. A file
# still as the package or an update installed it, or a missing one, is replaced. One edited by hand
# stays as it is, and when the release brings a new version of it, the update shows how the two
# differ. Like the command and the units, they run as root and stay after a manager is gone, so
# they come only from a release, and only from the one this command came with: an older one would
# bring older files, and a newer one runs its own command first (see update_cli).
update_system_files() {
    local image=$1 release=${1#"$MANAGER_REPOSITORY":} path new current shipped recorded mode level
    if [[ -z $CLI_VERSION || $release == "$image" || $release != "$CLI_VERSION" ]]; then
        echo "The system files stay as they are, since they come only from the release this thoric command came with${CLI_VERSION:+, $CLI_VERSION}."
        return 0
    fi
    for path in "${SYSTEM_FILES[@]}"; do
        mkdir -p "$tmp/system$(dirname "$path")"
        if ! docker run --rm --network none --entrypoint cat "$image" "/app/install/system$path" >"$tmp/system$path" 2>/dev/null ||
            [[ ! -s $tmp/system$path ]]; then
            echo "$image has no /app/install/system$path, so the system files stay as they are."
            return 0
        fi
    done
    : >"$tmp/system.sha256"
    for path in "${SYSTEM_FILES[@]}"; do
        new=$(checksum "$tmp/system$path")
        current=""
        if [[ -e $SYSTEM_ROOT$path ]]; then current=$(checksum "$SYSTEM_ROOT$path"); fi
        shipped=$(shipped_system "$path" "$current")
        recorded=$new
        if [[ $current == "$new" ]]; then
            :
        elif [[ -n $current && $current != "$shipped" ]]; then
            if [[ $new != "$shipped" ]]; then
                echo "$path has changes of your own, so it stays as it is. The release has it as below; carry over what you need."
                diff -u --label "$path (yours)" --label "$path ($CLI_VERSION)" "$SYSTEM_ROOT$path" "$tmp/system$path" |
                    head -n 80 || true
            fi
        elif [[ $path == /etc/docker/daemon.json ]] &&
            ! sudo dockerd --validate --config-file "$tmp/system$path" >/dev/null 2>&1; then
            # The packages below may bring a Docker Engine that takes it; the next update tries again.
            echo "This Docker Engine refuses the release's daemon.json, so $path stays as it is for now."
            recorded=$current
        else
            if [[ -e $SYSTEM_ROOT$path ]]; then
                mkdir -p "$tmp/system-previous$(dirname "$path")"
                cp -p "$SYSTEM_ROOT$path" "$tmp/system-previous$path"
            fi
            mode=0644
            if [[ $path == *.sh ]]; then mode=0755; fi
            put_file "$SYSTEM_ROOT$path" "$tmp/system$path" "$mode"
            system_changed+=("$path")
            echo "Updated $path."
        fi
        printf '%s  %s\n' "$recorded" "$path" >>"$tmp/system.sha256"
    done
    put_file "$SYSTEM_RECORD" "$tmp/system.sha256" 0644
    level=$(cat "$PACKAGE_LEVEL" 2>/dev/null || true)
    if ! [[ $level =~ ^[0-9]+$ ]] || ((10#$level < SYSTEM_LEVEL)); then
        printf '%s\n' "$SYSTEM_LEVEL" >"$tmp/package-level"
        put_file "$PACKAGE_LEVEL" "$tmp/package-level" 0644
    fi
    if listed /etc/systemd/system/thoric-firewall.service "${system_changed[@]}"; then
        sudo systemctl daemon-reload
    fi
    if listed /etc/systemd/system/thoric-firewall.service "${system_changed[@]}" ||
        listed /usr/lib/wsl/firewall-watch.sh "${system_changed[@]}"; then
        sudo systemctl try-restart thoric-firewall.service
    fi
}
# The packages Thoric relies on, whose versions an update names when they change.
SYSTEM_PACKAGES=(docker-ce docker-ce-cli containerd.io docker-compose-plugin nvidia-container-toolkit)
package_versions() {
    dpkg-query -W -f '${Package} ${Version}\n' "${SYSTEM_PACKAGES[@]}" 2>/dev/null || true
}
# Every package of the distribution as its repository has it now, Ubuntu's, Docker's and NVIDIA's,
# with the new packages an upgrade needs. Docker Engine stays within the major release that
# /etc/apt/preferences.d/thoric-docker.pref names, which a Thoric release moves, and configuration
# files edited by hand stay as they are. Those of SYSTEM_PACKAGES that changed go into upgraded.
upgrade_packages() {
    local before after line apt=(sudo env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300)
    before=$(package_versions)
    echo "Updating the distribution's packages."
    if ! "${apt[@]}" -qq update ||
        ! "${apt[@]}" -q -y --with-new-pkgs -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade; then
        echo "The distribution's packages were not updated; apt-get says why above. The next update tries again, and 'thoric system' does now." >&2
        return 0
    fi
    after=$(package_versions)
    while IFS= read -r line; do
        upgraded+=("${line%%:*}")
        echo "  $line"
    done < <(awk 'NR == FNR { was[$1] = $2; next }
        $1 != "" && was[$1] != $2 { print $1 ": " (was[$1] == "" ? "installed" : was[$1] " to") " " $2 }' \
        <(printf '%s\n' "$before") <(printf '%s\n' "$after"))
}
# Whether a value can stand as KEY=value in .env and come back unchanged: one line of printable
# ASCII, without the quotes, $, #, backslashes and backquotes that Compose's quoting and
# interpolation would read otherwise, and without the spaces at either end that it trims. The
# manager refuses the same values (env_value in core/manager/src/config.rs); this checks them
# again, since the request comes from the manager's container.
dashboard_value() {
    local LC_ALL=C value=$1 printable='^[ -~]*$'
    [[ ${#value} -le 2048 && $value =~ $printable && $value != *[\$\#\"\'\`\\]* &&
        $value != [[:space:]]* && $value != *[[:space:]] ]]
}
dashboard_setting() {
    local name
    for name in "${DASHBOARD_SETTINGS[@]}"; do
        if [[ $1 == "$name" ]]; then return 0; fi
    done
    return 1
}
dashboard_secret() {
    local name
    for name in "${DASHBOARD_SECRETS[@]}"; do
        if [[ $1 == "$name" ]]; then return 0; fi
    done
    return 1
}
# Whether the manager answers its health check within the seconds given, SETTINGS_WAIT unless
# named, asked inside its container, so whatever address Compose publishes it on. A manager that
# refuses its settings or its database exits, and Docker starts it again.
manager_answers() {
    local _
    for _ in $(seq 1 "${1:-$SETTINGS_WAIT}"); do
        if compose exec -T manager curl -fsS --max-time 2 -o /dev/null http://127.0.0.1:8080/healthz >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}
# Leave only the first line, the dashboard job's, in a request apply-settings has read: the next
# manager reads that line to follow the job, and the rest can hold a secret such as NOTIFY_URL,
# which then stays in .env alone.
forget_request() {
    printf '%s\n' "$2" | sudo tee "$1.new" >/dev/null
    sudo mv -f "$1.new" "$1"
}
# A settings change the dashboard asked for: the request's first line names the dashboard's job,
# and each line after it is KEY=value for one of DASHBOARD_SETTINGS. Nothing changes unless every
# line is one; then only those lines of .env change, in place, a missing one is added at the end
# and the rest of the file, comments and order, stays. The previous file is kept as .env.previous,
# and is put back when the manager does not answer with the new one. The output names the value of
# a secret of DASHBOARD_SECRETS as [hidden].
apply_settings() {
    local request=$1 line key value i
    local -a keys=() values=() lines=()
    local -A asked=()
    while IFS= read -r line || [[ -n $line ]]; do
        lines+=("$line")
        if ((${#lines[@]} > ${#DASHBOARD_SETTINGS[@]} + 1)); then
            break
        fi
    done <"$request"
    forget_request "$request" "${lines[0]:-}"
    if ((${#lines[@]} > ${#DASHBOARD_SETTINGS[@]} + 1)); then
        echo "The request asks for more settings than the dashboard can change; nothing was changed." >&2
        return 1
    fi
    for line in "${lines[@]:1}"; do
        key=${line%%=*}
        value=${line#*=}
        if [[ $line != *=* ]] || ! dashboard_setting "$key"; then
            echo "The dashboard cannot change '${key:0:64}'; that changes only with 'thoric settings'. Nothing was changed." >&2
            return 1
        fi
        if [[ -n ${asked[$key]:-} ]]; then
            echo "The request names $key twice; nothing was changed." >&2
            return 1
        fi
        if ! dashboard_value "$value"; then
            echo "$key cannot be written to .env as asked: use one line of printable ASCII without quotes, \$, #, backslashes or backquotes. Nothing was changed." >&2
            return 1
        fi
        asked[$key]=1
        keys+=("$key")
        values+=("$value")
    done
    if ((${#keys[@]} == 0)); then
        echo "The request changes no setting; nothing was changed." >&2
        return 1
    fi
    if systemctl is-active --quiet thoric-update.service; then
        echo "An update is running, so the settings stay as they are. Change them once it has finished." >&2
        return 1
    fi
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    local changes=""
    echo "The dashboard asks for these settings:"
    for i in "${!keys[@]}"; do
        changes+="${keys[i]}=${values[i]}"$'\n'
        if [[ -n ${values[i]} ]] && dashboard_secret "${keys[i]}"; then
            echo "  ${keys[i]}=[hidden]"
        else
            echo "  ${keys[i]}=${values[i]}"
        fi
    done
    # Values go through the environment, so awk reads them as they are.
    CHANGES=$changes awk '
        BEGIN {
            n = split(ENVIRON["CHANGES"], lines, "\n")
            for (i = 1; i <= n; i++) {
                eq = index(lines[i], "=")
                if (eq < 2) continue
                key = substr(lines[i], 1, eq - 1)
                value[key] = substr(lines[i], eq + 1)
                order[++count] = key
            }
        }
        {
            eq = index($0, "=")
            key = substr($0, 1, eq - 1)
            if (eq > 1 && key in value) {
                if (!(key in written)) print key "=" value[key]
                written[key] = 1
                next
            }
            print
        }
        END { for (i = 1; i <= count; i++) if (!(order[i] in written)) print order[i] "=" value[order[i]] }
    ' "$INSTALL/.env" >"$tmp/env"
    sudo cp -p "$INSTALL/.env" "$INSTALL/.env.previous"
    put_file "$INSTALL/.env" "$tmp/env"
    local written
    written=$(IFS=,; echo "${keys[*]}")
    echo "Wrote ${written//,/, } to $INSTALL/.env; the previous file is $INSTALL/.env.previous."
    echo "Recreating the manager with the new settings."
    if compose up -d --force-recreate manager && manager_answers; then
        echo "The manager answers with the new settings."
        return 0
    fi
    echo "The manager did not answer within $SETTINGS_WAIT seconds with the new settings, so .env is back as it was."
    put_file "$INSTALL/.env" "$INSTALL/.env.previous"
    if compose up -d --force-recreate manager && manager_answers; then
        echo "The manager answers with the previous settings again."
    else
        echo "The manager does not answer with the previous settings either. Run 'thoric logs' and 'thoric doctor'."
    fi
    return 1
}
case ${1:-help} in
    start)
        require_settings
        ensure_docker
        compose up -d
        echo "Thoric is starting at $(address)"
        ;;
    stop)
        compose stop
        ;;
    restart)
        require_settings
        ensure_docker
        compose up -d --force-recreate manager
        ;;
    status)
        if docker info >/dev/null 2>&1; then
            compose ps
            if curl -fsS "http://127.0.0.1:$(port)/healthz" >/dev/null 2>&1; then
                echo "Dashboard: $(address), reachable from $(access)"
            else
                echo "The manager is not answering yet."
            fi
        else
            echo "Docker is not running. Use 'thoric start'."
        fi
        ;;
    logs)
        compose logs --tail=100 manager
        ;;
    update)
        require_settings
        ensure_docker
        # The package pins the manager to the release it belongs to, and only an update moves that pin,
        # to the newest release and never back. Any other MANAGER_IMAGE, such as latest or a digest, was
        # chosen by hand and is pulled again as it is.
        current=$(setting MANAGER_IMAGE)
        image=$current
        pinned=${current#"$MANAGER_REPOSITORY":}
        if [[ -z $current || ($pinned != "$current" && $pinned =~ ^[0-9]+\.[0-9]+\.[0-9]+$) ]]; then
            version=$(newest_release)
            if [[ -n $current && $(printf '%s\n' "$version" "$pinned" | sort -V | tail -n1) == "$pinned" ]]; then
                echo "The manager stays on $pinned; the newest release is $version."
            else
                image=$MANAGER_REPOSITORY:$version
            fi
        fi
        # The installation files and the command come from the manager about to run, so it is pulled
        # first. A newer command takes the update over before anything here changes.
        docker pull "$image"
        tmp=$(mktemp -d)
        previous=""
        trap 'rm -rf "$tmp"' EXIT
        update_cli "$image"
        keep_previous
        trap finish_update EXIT
        update_install_files "$image"
        # The pin moves once the files of its release are in place, so .env never names a manager
        # whose settings the compose.yml beside it does not pass.
        if [[ $image != "$current" ]]; then
            set_setting MANAGER_IMAGE "$image"
            echo "The manager moves from ${pinned:-latest} to $version."
        fi
        update_units "$image"
        socket=$(socket_id)
        update_system "$image"
        rename_settings
        compose pull
        echo "Recreating the manager $image."
        if [[ $(socket_id) != "$socket" ]]; then
            echo "Docker made its socket again, so the containers of compose.yml are created again with it."
            compose up -d --force-recreate
        else
            compose up -d
        fi
        # A manager that refuses its database or its settings exits again and again, while
        # compose up has already succeeded, so the update waits for its health check.
        if ! manager_answers "$UPDATE_WAIT"; then
            echo "The manager $image did not answer within $UPDATE_WAIT seconds. Its last lines:"
            compose logs --no-log-prefix --tail=30 manager || true
            exit 1
        fi
        previous=""
        echo "The manager answers."
        update_profiles
        ;;
    system)
        require_settings
        ensure_docker
        if systemctl is-active --quiet thoric-update.service; then
            echo "An update is running, which brings the system up to date as well." >&2
            exit 1
        fi
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        socket=$(socket_id)
        update_system "$(setting MANAGER_IMAGE)"
        # A container keeps the socket it was started with, so a running manager needs the new one.
        if [[ $(socket_id) != "$socket" && -n $(compose ps -q manager 2>/dev/null) ]]; then
            echo "Docker made its socket again, so the containers of compose.yml are created again with it."
            compose up -d --force-recreate
            if ! manager_answers "$UPDATE_WAIT"; then
                echo "The manager did not answer within $UPDATE_WAIT seconds. Run 'thoric logs' and 'thoric doctor'." >&2
                exit 1
            fi
            echo "The manager answers."
        fi
        ;;
    doctor)
        echo "systemd:   $(systemctl is-system-running 2>/dev/null || true)"
        echo "docker:    $(systemctl is-active docker 2>/dev/null || true)"
        if docker info --format 'engine {{.ServerVersion}}, live-restore {{.LiveRestoreEnabled}}, runtimes: {{range $k, $v := .Runtimes}}{{$k}} {{end}}' 2>/dev/null; then :; else echo "docker info failed"; fi
        # WSL distributions share one network namespace, so another one can clear Docker's rules.
        if systemctl is-enabled --quiet nftables 2>/dev/null; then
            echo "nftables:  enabled; it flushes the firewall of every WSL distribution when it starts or stops. Run 'sudo systemctl mask nftables'."
        fi
        if missing=$(sudo -n /usr/lib/wsl/firewall-watch.sh --check 2>/dev/null); then
            echo "firewall:  Docker's rules are in place ($(systemctl is-active thoric-firewall 2>/dev/null || true) watcher)"
        elif [[ -n $missing ]]; then
            echo "firewall:  no rules for $(awk '{print $1}' <<<"$missing" | paste -sd, -); another WSL distribution removed them. 'sudo systemctl restart docker' restores them."
        else
            echo "firewall:  not checked (needs sudo and a running Docker)"
        fi
        # Memory and processors are set for every WSL distribution together in .wslconfig on Windows,
        # while the disk limit belongs to this distribution's virtual disk. MemTotal sits a little below
        # the configured size, so the memory check allows for that and memory=8GB passes.
        awk '/^MemTotal:/ { mem = $2 } /^SwapTotal:/ { swap = $2 } END {
            printf "memory:    %.1f GiB, swap %.1f GiB", mem / 1048576, swap / 1048576
            if (mem < 7.5 * 1048576) printf "; below 8 GB, raise memory= in %%UserProfile%%\\.wslconfig and run wsl --shutdown"
            print ""
        }' /proc/meminfo
        echo "CPUs:      $(nproc)"
        df -Pk / | awk -v distro="${WSL_DISTRO_NAME:-Thoric}" 'NR == 2 {
            printf "disk:      %.0f GiB free of %.0f GiB", $4 / 1048576, $2 / 1048576
            if ($4 < 10 * 1048576) printf "; below 10 GB, enlarge it from Windows with wsl --manage %s --resize <size>", distro
            print ""
        }'
        if [[ -e /dev/dxg ]]; then echo "WSL GPU:   /dev/dxg present"; else echo "WSL GPU:   /dev/dxg missing (install a WSL-capable GPU driver on Windows)"; fi
        if compgen -G "/usr/lib/wsl/lib/libcuda.so*" >/dev/null; then echo "CUDA:      libcuda found in /usr/lib/wsl/lib"; else echo "CUDA:      libcuda not found; NVIDIA_COMPUTE should stay false"; fi
        if [[ -x /usr/lib/wsl/lib/nvidia-smi ]]; then /usr/lib/wsl/lib/nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null || true; fi
        # Under NAT networking Windows forwards only its own localhost into WSL, whatever the bind address.
        reach=$(access)
        networking=$(wslinfo --networking-mode 2>/dev/null || true)
        printf 'access:    reachable from %s, WSL networking %s' "$reach" "${networking:-unknown}"
        if [[ $reach == other* && $networking == nat ]]; then printf '; other devices need mirrored networking or a port proxy on Windows'; fi
        echo
        if [[ -f $INSTALL/.env ]]; then echo "settings:  $INSTALL/.env"; grep -E '^(WSL_GPU|NVIDIA_COMPUTE|GPU_ADAPTER|AUTH_MODE|ADMIN_USERNAME|PORT|BIND_ADDRESS|ALLOWED_HOSTS|ROOT_MCP_ENABLED|MCP_ENABLED|MCP_AUTH_MODE)=' "$INSTALL/.env" | sed 's/^/           /' || true; else echo "settings:  missing"; fi
        # Docker downloads images itself, as a service, with the proxy its own settings give it and
        # none of this shell's. So Docker looks up the manager's image: the Engine API's
        # /distribution resolves its manifest in the registry and downloads nothing. A registry that
        # answers with an error is reachable all the same.
        image=""
        if [[ -f $INSTALL/.env ]]; then image=$(setting MANAGER_IMAGE); fi
        image=${image:-$MANAGER_REPOSITORY:latest}
        registry=${image%%/*}
        proxy=$(docker info --format '{{.HTTPSProxy}}' 2>/dev/null || true)
        via="no proxy"
        if [[ -n $proxy ]]; then via="proxy $proxy"; fi
        answer=$(curl -sS --max-time 60 -w '\n%{http_code}' --unix-socket /var/run/docker.sock \
            "http://localhost/distribution/$image/json" 2>&1 || true)
        code=${answer##*$'\n'}
        reason=$(sed -n 's/.*"message": *"\(.*\)".*/\1/p' <<<"$answer" | sed 's/\\"/"/g' | head -n1 | cut -c1-200)
        case $code in
            200) echo "registry:  Docker reaches $registry ($via)" ;;
            4[0-9][0-9]) echo "registry:  Docker reaches $registry ($via), which answers about $image: $reason" ;;
            *)
                printf 'registry:  Docker does not reach %s (%s): %s' "$registry" "$via" "${reason:-Docker gave no answer}"
                if [[ -z $proxy && -n ${HTTPS_PROXY:-${https_proxy:-}} ]]; then
                    printf '. This shell has a proxy and Docker none'
                fi
                echo "; see 'Docker behind a proxy' in docs/WSL_PACKAGE.md"
                ;;
        esac
        ;;
    open)
        if command -v explorer.exe >/dev/null; then explorer.exe "$(address)" || true; else address; fi
        ;;
    mcp)
        require_settings
        # Called MCP_ENABLED before 0.6.3; the manager still reads that name while the new one is missing.
        enabled=$(setting ROOT_MCP_ENABLED)
        if [[ -z $enabled ]]; then enabled=$(setting MCP_ENABLED); fi
        mode=$(sed -n 's/^MCP_AUTH_MODE=//p' "$INSTALL/.env" | tail -n1)
        token=$(sed -n 's/^MCP_TOKEN=//p' "$INSTALL/.env" | tail -n1)
        # The first start single-quotes the token so Compose keeps $ and # literal; older files have none.
        if [[ $token =~ ^\'(.*)\'$ || $token =~ ^\"(.*)\"$ ]]; then token=${BASH_REMATCH[1]}; fi
        if [[ $enabled != true || ($mode != none && -z $token) ]]; then
            echo "Root agent access (/mcp) is off. MCP endpoints made on the dashboard's MCP page work without it, each with its own token, and its Connect shows their client settings." >&2
            echo "To turn on /mcp, which reaches every desktop, set ROOT_MCP_ENABLED=true and MCP_TOKEN (or MCP_AUTH_MODE=none) with 'thoric settings', then run 'thoric restart'." >&2
            exit 1
        fi
        distro=${WSL_DISTRO_NAME:-Thoric}
        # The bridge runs in the manager's container, which MANAGER_CONTAINER names in Compose.
        manager=$(setting MANAGER_CONTAINER)
        manager=${manager:-thoric-manager}
        claude_shell=""
        if [[ $mode == none ]]; then
            echo "Agent access (MCP) is enabled without a token. Anything that reaches the address controls every desktop."
            header="" claude_header=""
            footer="Require a token by setting MCP_AUTH_MODE=token and MCP_TOKEN with 'thoric settings', then run 'thoric restart'."
        else
            echo "Agent access (MCP) is enabled. The token grants administrator access to every desktop."
            header=$'\n'"  Header:  Authorization: Bearer $token"
            if [[ $token =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
                claude_header=" --header \"Authorization: Bearer $token\""
            else
                # cmd or PowerShell would expand $ % ` " inside double quotes; PowerShell single quotes keep
                # everything literal but a single quote, which is doubled.
                quote="'"
                claude_shell=" (PowerShell)"
                claude_header=" --header 'Authorization: Bearer ${token//$quote/$quote$quote}'"
            fi
            footer="Rotate the token by editing MCP_TOKEN with 'thoric settings', then run 'thoric restart'."
        fi
        others=""
        if [[ $(access) == other* ]]; then
            others=$'\n'"  Other devices use this computer's network address in place of localhost."
        fi
        cat <<EOF

Streamable HTTP
  URL:     $(address)/mcp$header$others

Claude Code on Windows$claude_shell:
  claude mcp add --transport http thoric $(address)/mcp$claude_header

stdio bridge (no token in the client; it runs inside the manager container):
  {
    "mcpServers": {
      "thoric": {
        "command": "wsl.exe",
        "args": ["-d", "$distro", "--", "docker", "exec", "-i", "$manager", "python3", "/app/mcp_bridge.py"]
      }
    }
  }

$footer
EOF
        ;;
    settings)
        require_settings
        # .env belongs to root and the docker group may only read it, so the editor cannot save it
        # directly. sudoedit opens a copy in the user's editor and writes it back with the file's owner
        # and mode; it picks SUDO_EDITOR, VISUAL or EDITOR, and nano when none is set.
        SUDO_EDITOR=${SUDO_EDITOR:-${VISUAL:-${EDITOR:-nano}}} sudo --edit "$INSTALL/.env"
        echo "Run 'thoric restart' to apply the settings."
        ;;
    apply-settings)
        # thoric-settings.service runs this as root with the request the dashboard left; see
        # core/manager/src/config/changes.rs.
        require_settings
        if [[ $# -ne 2 || ! -f $2 ]]; then
            echo "Usage: thoric apply-settings <request>, as thoric-settings.service runs it" >&2
            exit 2
        fi
        ensure_docker
        apply_settings "$2"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
