# Use 0.0.0.0 for LAN access. Default: localhost only.
BIND_ADDRESS=127.0.0.1
PORT=8080
MANAGER_CONTAINER=thoric-manager
AUTH_MODE=password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional root agent access at /mcp, to every container (called MCP_ENABLED before 0.6.3). MCP
# endpoints made on the dashboard answer without it. Use a separate randomly generated token,
# which opens the endpoints too. MCP_AUTH_MODE=none drops the token: anyone who reaches the
# address can use /mcp and every endpoint, while ROOT_MCP_ENABLED=true. With BIND_ADDRESS=0.0.0.0
# that includes every desktop with internet access, so keep sign-in and the token on there.
ROOT_MCP_ENABLED=false
MCP_TOKEN=
MCP_AUTH_MODE=token
# Prometheus metrics at /metrics, read with this token as a bearer token. Empty keeps the route
# off, also with AUTH_MODE=none. Use a separate randomly generated token, such as the output of
# openssl rand -hex 32; it opens /metrics alone.
METRICS_TOKEN=
SECURE_COOKIE=false
# Used by compose.ghcr.yml. latest is the newest release and edge follows master; pin a version
# or digest for reproducible upgrades.
MANAGER_IMAGE=ghcr.io/co3moz/thoric:latest
DESKTOP_IMAGE=ghcr.io/co3moz/thoric/ubuntu-xfce:24.04
# GPU desktops get the GPU through each route these allow that the host has, which the manager
# looks for when it starts: the WSL GPU in WSL, the NVIDIA Container Toolkit (CUDA, and OpenGL
# outside WSL), and the /dev/dri render devices of AMD and Intel GPUs, or of a board such as the
# Raspberry Pi, outside WSL (experimental).
WSL_GPU=true
NVIDIA_COMPUTE=true
DRI_GPU=true
# The GPU to render on: NVIDIA / AMD / Intel, or in WSL part of the D3D12 adapter's model name.
GPU_ADAPTER=
AUDIO_ENABLED=true
MICROPHONE_ENABLED=true
# Container features. INTERNET_ENABLED, SUDO_ENABLED, GAMEPAD_ENABLED and VPN_ENABLED, like
# AUDIO_ENABLED and MICROPHONE_ENABLED, switch one off for the whole installation; WSL_GPU,
# NVIDIA_COMPUTE and DRI_GPU do that for the GPU. A new container cannot get a switched-off feature,
# and one that has it keeps it in its settings. The _DEFAULT settings are what the create form starts
# with and what a create request gets when it leaves a feature out. VPN gives a container NET_ADMIN
# and /dev/net/tun, so a VPN client inside it can open a tunnel.
INTERNET_ENABLED=true
SUDO_ENABLED=true
GAMEPAD_ENABLED=true
VPN_ENABLED=true
GPU_DEFAULT=true
INTERNET_DEFAULT=true
SUDO_DEFAULT=true
AUDIO_DEFAULT=false
MICROPHONE_DEFAULT=false
GAMEPAD_DEFAULT=false
VPN_DEFAULT=false
# Minutes a new container's desktop may go unused before Thoric stops it, unless the container
# asks otherwise; 0 never stops one. It is copied into the container's settings, so a change
# leaves existing containers as they are. Up to 10080, a week.
IDLE_STOP_DEFAULT=0
# Lets desktops create user namespaces, which Chrome, Edge and Electron apps sandbox with.
# false keeps Docker's default seccomp profile; those apps then start only with --no-sandbox.
DESKTOP_USER_NAMESPACES=true
# How many processes and threads one desktop may run, so a runaway program or a fork bomb stops
# there instead of exhausting the host. Threads count, and browsers, IDEs and Unity run thousands.
# At least 1024, or 0 for no limit. Running desktops get a new value without a restart.
DESKTOP_PIDS_LIMIT=16384
# Per-file upload limit in MiB. Two transfers can run simultaneously.
UPLOAD_MAX_MB=1024
# Largest image or volume archive an import accepts, in MiB after decompression. Image archives hold every layer.
IMAGE_ARCHIVE_MAX_MB=65536
# The list the Templates page reads in the browser. Empty uses the Thoric wiki; none turns the page off.
TEMPLATES_URL=
# The label a volume needs to be listed and mounted, key or key=value. Empty keeps the label
# Thoric gives every volume it creates; none shows every Docker volume.
VOLUME_FILTER=
# The proxy that desktops' programs go through when a container follows the installation's:
# http://, https:// or socks5:// with a host and a port, such as http://proxy.example:3128. Empty
# gives the installation none. A container can have a proxy of its own, or none, instead.
PROXY_URL=
# The proxy's user name and password, when it asks for them. Put a password that holds $, # or
# quotes in single quotes. The password changes only here, with thoric settings in the WSL package.
PROXY_USERNAME=
PROXY_PASSWORD=
# Hosts that skip the proxy, separated by commas: a name with the names below it
# (intranet.example), an address or a network (10.0.0.0/8). The desktop itself always does.
PROXY_BYPASS=
# Look up the newest release on GitHub every six hours and show it in the dashboard, which in
# the WSL package can also run the update. false turns both off.
UPDATE_CHECK=true
# Where notices go, such as an agent's request for a person while nobody has the dashboard open:
# addresses separated by commas, each sent one POST. ntfy (https://ntfy.sh/<topic>, or
# ntfy+https://<server>/<topic> for one of your own, with ?token= and ?priority= when needed),
# a Discord or Slack incoming webhook, a Telegram bot's sendMessage address with ?chat_id=, or any
# other address, which gets a JSON payload. The address holds its credentials, so it changes
# only here, with thoric settings in the WSL package; put one that holds $ in single quotes.
NOTIFY_URL=
# What is sent, separated by commas: human_request, job_failed, update_available. Empty sends
# human_request; none sends nothing.
NOTIFY_EVENTS=
# The address you reach the dashboard at, such as https://thoric.lan:8443, so a notice links to
# the desktop that needs you. Empty sends notices without a link to the dashboard.
DASHBOARD_URL=
# The manager's log filter. Empty keeps thoric=info,tower_http=info, a line for every request;
# thoric=debug adds the reads a page or a health check repeats on a timer.
RUST_LOG=
DESKTOP_HOST=localhost
# localhost and private IPs are allowed. Add DNS names separated by commas.
ALLOWED_HOSTS=localhost
HTTPS_PORT=8443


MANAGER_DATA_VOLUME=thoric-data
